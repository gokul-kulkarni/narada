{
  "name": "narada-workspace",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @narada/desktop dev",
    "tauri": "pnpm --filter @narada/desktop tauri",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "coverage": "nx run-many -t coverage",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "e2e": "pnpm --filter @narada/desktop e2e",
    "test:rust": "pnpm --filter @narada/desktop test:rust",
    "check": "nx run-many -t typecheck lint test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "nx": "^24.0.6",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  }
}
